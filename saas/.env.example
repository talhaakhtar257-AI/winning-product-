# ── Supabase (Project settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app (used for checkout redirects and share links)
NEXT_PUBLIC_SITE_URL=https://app.yourdomain.com

# Make.com → POST /api/ingest with header "Authorization: Bearer <INGEST_SECRET>" (min 24 chars)
INGEST_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/expire (min 16 chars)
CRON_SECRET=

# ── Lemon Squeezy (Settings → API / Webhooks) ──
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Paddle Billing (Developer tools → Authentication / Notifications) ──
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=true
